{
  "manifest_version": 2,
  "name": "Browser Control Bridge for Firefox",
  "version": "0.3.1",
  "description": "Let your local AI assistant read and control Firefox tabs after you pair this add-on.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{733bdf90-e75f-42d5-9b0c-0cc486bf8133}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity",
          "personallyIdentifyingInfo",
          "personalCommunications",
          "healthInfo",
          "financialAndPaymentInfo",
          "authenticationInfo",
          "locationInfo",
          "searchTerms"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "config.js",
      "local-transport.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Firefox Control",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "incognito": "not_allowed",
  "content_security_policy": "script-src 'self'; object-src 'none';",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
